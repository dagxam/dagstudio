document.addEventListener('DOMContentLoaded', function() {
    
    // --- 1. МОБИЛЬНОЕ МЕНЮ ---
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileOverlay = document.getElementById('mobile-menu-overlay');
    const closeMobile = document.querySelector('.close-mobile-nav');

    if(mobileBtn) {
        mobileBtn.addEventListener('click', function() {
            mobileOverlay.classList.add('active');
        });
    }

    if(closeMobile) {
        closeMobile.addEventListener('click', function() {
            mobileOverlay.classList.remove('active');
        });
    }

    const mobileLinks = document.querySelectorAll('.mobile-links a');
    mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
            mobileOverlay.classList.remove('active');
        });
    });

    // --- 2. ЛОГИКА ОКОН (Login, Order, Buy, Timer) ---
    var loginModal = document.getElementById('login-modal');
    var loginBtn = document.getElementById('login-btn');
    var closeLogin = document.getElementsByClassName('login-close')[0];

    if(loginBtn && loginModal) {
        loginBtn.onclick = function(e) {
            e.preventDefault();
            loginModal.style.display = "flex";
            setTimeout(() => { loginModal.classList.add('show'); }, 10);
        }
        closeLogin.onclick = function() {
            loginModal.classList.remove('show');
            setTimeout(() => { loginModal.style.display = "none"; }, 300);
        }
    }

    var orderModal = document.getElementById('order-modal');
    var orderBtn = document.getElementById('hero-order-btn');
    var closeOrder = document.getElementsByClassName('order-close')[0];

    if(orderBtn && orderModal) {
        orderBtn.onclick = function(e) {
            e.preventDefault();
            orderModal.style.display = "flex";
            setTimeout(() => { orderModal.classList.add('show'); }, 10);
        }
        closeOrder.onclick = function() {
            orderModal.classList.remove('show');
            setTimeout(() => { orderModal.style.display = "none"; }, 300);
        }
    }

    var buyModal = document.getElementById('buy-script-modal');
    var buyBtns = document.querySelectorAll('.btn-buy');
    var closeBuy = document.querySelector('.buy-close');
    var scriptNameField = document.getElementById('buy-script-name');

    buyBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            var title = this.getAttribute('data-title');
            if(scriptNameField) scriptNameField.innerText = title; 
            buyModal.style.display = "flex";
            setTimeout(() => { buyModal.classList.add('show'); }, 10);
        });
    });

    if(closeBuy) {
        closeBuy.onclick = function() {
            buyModal.classList.remove('show');
            setTimeout(() => { buyModal.style.display = "none"; }, 300);
        }
    }

    var timerModal = document.getElementById('timer-modal');
    var downloadBtns = document.querySelectorAll('.btn-download');
    var closeTimer = document.querySelector('.timer-close');
    var countdownSpan = document.getElementById('countdown');
    var timerBox = document.getElementById('timer-box');
    var downloadReady = document.getElementById('download-ready');
    var finalLink = document.getElementById('final-download-link');
    var interval;

    downloadBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            var fileLink = this.getAttribute('data-link');
            if(!fileLink) { alert('Ошибка: Ссылка на файл отсутствует'); return; }

            timerBox.style.display = 'block';
            downloadReady.style.display = 'none';
            countdownSpan.innerText = "10";
            finalLink.href = fileLink;

            timerModal.style.display = "flex";
            setTimeout(() => { timerModal.classList.add('show'); }, 10);

            var timeLeft = 10;
            interval = setInterval(function() {
                timeLeft--;
                countdownSpan.innerText = timeLeft;
                if(timeLeft <= 0) {
                    clearInterval(interval);
                    timerBox.style.display = 'none';
                    downloadReady.style.display = 'block';
                }
            }, 1000);
        });
    });

    if(closeTimer) {
        closeTimer.onclick = function() {
            clearInterval(interval);
            timerModal.classList.remove('show');
            setTimeout(() => { timerModal.style.display = "none"; }, 300);
        }
    }

    window.onclick = function(event) {
        if (event.target == loginModal) {
            loginModal.classList.remove('show');
            setTimeout(() => { loginModal.style.display = "none"; }, 300);
        }
        if (event.target == orderModal) {
            orderModal.classList.remove('show');
            setTimeout(() => { orderModal.style.display = "none"; }, 300);
        }
        if (event.target == buyModal) {
            buyModal.classList.remove('show');
            setTimeout(() => { buyModal.style.display = "none"; }, 300);
        }
        if (event.target == timerModal) {
            clearInterval(interval);
            timerModal.classList.remove('show');
            setTimeout(() => { timerModal.style.display = "none"; }, 300);
        }
    }
});