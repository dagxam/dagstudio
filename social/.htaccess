# ТОЛЬКО /social/: открыть VK Mini App внутри проверенных платформ.
# Не меняет CSP и X-Frame-Options остальных страниц dagstudio.ru.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always unset X-Frame-Options
  Header onsuccess unset X-Frame-Options
  Header always unset Content-Security-Policy
  Header onsuccess unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self' https://vk.com https://*.vk.com https://vk.ru https://*.vk.ru https://ok.ru https://*.ok.ru; base-uri 'none'; object-src 'none'; form-action 'none'"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
