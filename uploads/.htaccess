Options -Indexes

<IfModule mod_mime.c>
  RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .sh .shtml .fcgi
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|shtml|fcgi|htaccess|ini)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|shtml|fcgi|htaccess|ini)$">
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Security-Policy "default-src 'none'; sandbox"
  Header always set X-Frame-Options "DENY"
</IfModule>
